{
  "name": "fussball-iq-kids",
  "version": "0.2.4",
  "private": true,
  "description": "Fußballspiel mit Entscheidungstraining für Kinder ab 5 Jahren (PWA)",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/play.mjs && node tests/e2e/transcript.mjs",
    "test:all": "npm test && npm run test:e2e",
    "build": "node scripts/build-site.mjs",
    "version:set": "node scripts/set-version.mjs",
    "check:live": "node scripts/check-live.mjs",
    "start": "npx --yes serve -l 8080 ."
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
